{% doc %}
  Renders the cart drawer with items, free shipping progress, and recommendations.

  @param {boolean} [show_recommendations] - Show product recommendations
  @param {collection} [recommendations_collection] - Collection for recommendations

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

<div id="cart-drawer" class="cart-drawer" data-cart-drawer aria-hidden="true" style="display: block;">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>

  <aside class="cart-drawer__container">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title">
        {{ 'cart.your_cart' | t }}
        <span class="cart-drawer__count" data-cart-drawer-count>{{ cart.item_count }}</span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'cart.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    {% if settings.cart_announcement != blank %}
      <div class="cart-drawer__announcement">
        {{ settings.cart_announcement }}
      </div>
    {% endif %}

    {% if settings.show_free_shipping_threshold %}
      {% assign free_shipping_threshold = settings.free_shipping_threshold | times: 100 %}
      {% assign cart_total_price = cart.total_price %}
      {% assign remaining_for_free_shipping = free_shipping_threshold | minus: cart_total_price %}

      <div class="cart-drawer__free-shipping">
        {% if remaining_for_free_shipping > 0 %}
          {% assign remaining_formatted = remaining_for_free_shipping | money %}
          <p class="cart-drawer__free-shipping-message">
            {{ 'cart.free_shipping_threshold' | t: amount: remaining_formatted }}
          </p>
          {% assign progress_percentage = cart_total_price | times: 100 | divided_by: free_shipping_threshold %}
          <div class="cart-drawer__progress-bar">
            <div class="cart-drawer__progress-fill" style="width: {{ progress_percentage }}%"></div>
          </div>
        {% else %}
          <p class="cart-drawer__free-shipping-success">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 0C4.48 0 0 4.48 0 10s4.48 10 10 10 10-4.48 10-10S15.52 0 10 0zm-2 15l-5-5 1.41-1.41L8 12.17l7.59-7.59L17 6l-9 9z"/>
            </svg>
            {{ 'cart.free_shipping_success' | t }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="cart-drawer__content">
      {% if cart.item_count > 0 %}
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form">
          <ul class="cart-drawer__items" role="list">
            {% for item in cart.items %}
              <li class="cart-drawer__item" data-cart-item="{{ item.key }}">
                {% render 'cart-line-item', item: item, drawer: true %}
              </li>
            {% endfor %}
          </ul>
        </form>

        {% if settings.show_cart_recommendations %}
          <div class="cart-drawer__recommendations">
            {% render 'cart-recommendations', collection: settings.cart_recommendations_collection %}
          </div>
        {% endif %}
      {% else %}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__continue-shopping">
            {{ 'cart.shop_now' | t }}
          </a>

          {% comment %} Show product recommendations for empty cart {% endcomment %}
          {% render 'cart-empty-recommendations', collection: settings.cart_recommendations_collection, limit: 3 %}
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <footer class="cart-drawer__footer">
        {%- comment -%} Cart Summary Lines {%- endcomment -%}
        <div class="cart-drawer__summary">
          {%- comment -%} Calculate subscription savings {%- endcomment -%}
          {%- liquid
            assign has_subscription = false
            assign total_subscription_savings = 0

            for item in cart.items
              if item.selling_plan_allocation
                assign has_subscription = true
                assign item_savings = item.variant.price | minus: item.selling_plan_allocation.price
                assign item_savings = item_savings | times: item.quantity
                assign total_subscription_savings = total_subscription_savings | plus: item_savings
              endif
            endfor
          -%}

          {%- if has_subscription and total_subscription_savings > 0 -%}
            <div class="cart-drawer__summary-line">
              <span>{{ 'cart.subscriber_savings' | t }}</span>
              <span class="cart-drawer__summary-savings">-{{ total_subscription_savings | money }}</span>
            </div>
          {%- endif -%}

          {%- comment -%} Shipping line {%- endcomment -%}
          {%- liquid
            assign show_free_shipping = false

            # Check threshold-based free shipping
            if settings.show_free_shipping_threshold
              assign threshold = settings.free_shipping_threshold | times: 100
              if cart.total_price >= threshold
                assign show_free_shipping = true
              endif
            endif

            # Check subscription-based free shipping
            if settings.free_shipping_for_subscriptions and has_subscription
              assign show_free_shipping = true
            endif
          -%}
          <div class="cart-drawer__summary-line">
            <span>{{ 'cart.shipping' | t }}</span>
            <span>
              {%- if show_free_shipping -%}
                {{ 'cart.free' | t }}
              {%- else -%}
                {{ 'cart.calculated_at_checkout' | t }}
              {%- endif -%}
            </span>
          </div>

          {%- comment -%} Subtotal {%- endcomment -%}
          <div class="cart-drawer__summary-line cart-drawer__summary-line--total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
        </div>

        {%- comment -%} Checkout Button {%- endcomment -%}
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout-form" data-checkout-form>
          <button type="submit" name="checkout" class="cart-drawer__checkout-button">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
              <path d="M11.5 5H10V3.5a3 3 0 1 0-6 0V5H2.5A.5.5 0 0 0 2 5.5v7a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5ZM5 3.5a2 2 0 1 1 4 0V5H5V3.5Z"/>
            </svg>
            {{ 'cart.checkout' | t }}
          </button>
        </form>
      </footer>
    {% endif %}
  </aside>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    pointer-events: none;
    display: flex !important;
    justify-content: flex-end;
    visibility: hidden;
  }

  .cart-drawer[aria-hidden="false"] {
    pointer-events: auto;
    visibility: visible;
  }

  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer[aria-hidden="false"] .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer__container {
    position: relative;
    width: 100%;
    max-width: 450px;
    height: 100%;
    background: var(--color-background);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
  }

  .cart-drawer[aria-hidden="false"] .cart-drawer__container {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-drawer__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-drawer__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    background: #FFD563;
    color: var(--color-foreground, #000);
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cart-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin: -0.5rem;
    color: var(--color-foreground);
    transition: opacity 0.2s;
  }

  .cart-drawer__close:hover {
    opacity: 0.7;
  }

  .cart-drawer__announcement {
    padding: 1rem 1.5rem;
    background: var(--color-primary, #000);
    color: var(--color-background);
    text-align: center;
    font-size: 0.875rem;
  }

  .cart-drawer__free-shipping {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-drawer__free-shipping-message {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    text-align: center;
  }

  .cart-drawer__free-shipping-success {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-success, #4caf50);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .cart-drawer__progress-bar {
    width: 100%;
    height: 8px;
    background: var(--color-border, #e5e5e5);
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-drawer__progress-fill {
    height: 100%;
    background: var(--color-primary, #000);
    transition: width 0.3s ease;
  }

  .cart-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cart-drawer__item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
  }

  .cart-drawer__empty {
    text-align: center;
    padding: 3rem 0;
  }

  .cart-drawer__empty p {
    margin: 0 0 1.5rem;
    font-size: 1.125rem;
    color: var(--color-foreground-secondary, #666);
  }

  .cart-drawer__continue-shopping {
    display: inline-block;
    padding: 12px 32px;
    background-color: #000000;
    color: #ffffff;
    border: 2px solid #000000;
    border-radius: 4px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .cart-drawer__continue-shopping:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .cart-drawer__recommendations {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
    background: var(--color-background);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Summary Lines */
  .cart-drawer__summary {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-drawer__summary-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9375rem;
  }

  .cart-drawer__summary-line--total {
    font-weight: 600;
    font-size: 1rem;
    padding-top: 0.5rem;
  }

  .cart-drawer__summary-savings {
    color: var(--color-success, #4caf50);
  }

  /* Checkout Button - Pill Style */
  .cart-drawer__checkout-form {
    margin-top: 0.5rem;
  }

  .cart-drawer__checkout-button {
    width: 100%;
    padding: 1rem 1.5rem;
    background: var(--color-accent, #c4a77d);
    color: #ffffff;
    border: none;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .cart-drawer__checkout-button:hover {
    background: var(--color-accent-dark, #a08a5a);
  }

  .cart-drawer__checkout-button svg {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .cart-drawer__container {
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  class CartDrawer {
    constructor() {
      this.drawer = document.querySelector('[data-cart-drawer]');
      if (!this.drawer) return;

      this.closeButtons = this.drawer.querySelectorAll('[data-cart-drawer-close]');
      this.bindEvents();
    }

    bindEvents() {
      // Close button events
      this.closeButtons.forEach(button => {
        button.addEventListener('click', () => this.close());
      });

      // ESC key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen()) {
          this.close();
        }
      });
    }

    open() {
      console.log('Opening cart drawer');
      this.drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Trap focus
      const focusableElements = this.drawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );

      if (focusableElements.length) {
        focusableElements[0].focus();
      }
    }

    close() {
      this.drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    isOpen() {
      return this.drawer.getAttribute('aria-hidden') === 'false';
    }

    updateCart(cart) {
      // This method will be called after AJAX cart updates
      // to refresh the cart drawer content
      fetch('/cart?view=drawer')
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const newDocument = parser.parseFromString(html, 'text/html');
          const newContent = newDocument.querySelector('.cart-drawer__content');
          const newFooter = newDocument.querySelector('.cart-drawer__footer');
          const newCount = newDocument.querySelector('[data-cart-drawer-count]');
          const newFreeShipping = newDocument.querySelector('.cart-drawer__free-shipping');

          if (newContent) {
            const currentContent = this.drawer.querySelector('.cart-drawer__content');
            currentContent.innerHTML = newContent.innerHTML;
          }

          // Update free shipping progress
          if (newFreeShipping) {
            const currentFreeShipping = this.drawer.querySelector('.cart-drawer__free-shipping');
            if (currentFreeShipping) {
              currentFreeShipping.innerHTML = newFreeShipping.innerHTML;
            }
          }

          // Update or remove footer based on cart state
          const currentFooter = this.drawer.querySelector('.cart-drawer__footer');
          if (newFooter) {
            if (currentFooter) {
              currentFooter.innerHTML = newFooter.innerHTML;
            } else {
              // Footer should exist but doesn't, create it
              const container = this.drawer.querySelector('.cart-drawer__container');
              const footerElement = document.createElement('footer');
              footerElement.className = 'cart-drawer__footer';
              footerElement.innerHTML = newFooter.innerHTML;
              container.appendChild(footerElement);
            }
          } else {
            // No footer in new HTML (cart is empty), remove existing footer
            if (currentFooter) {
              currentFooter.remove();
            }
          }

          // Update cart count in drawer header
          if (newCount) {
            const currentCount = this.drawer.querySelector('[data-cart-drawer-count]');
            if (currentCount) {
              currentCount.textContent = newCount.textContent;
            }
          }
        });
    }
  }

  // Initialize cart drawer immediately when script loads
  if (typeof window.cartDrawer === 'undefined') {
    window.cartDrawer = new CartDrawer();
  }

  // Also ensure it's available on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.cartDrawer === 'undefined') {
      window.cartDrawer = new CartDrawer();
    }
  });

  // Handle empty cart recommendations add to cart
  document.addEventListener('submit', async (e) => {
    if (e.target.matches('[data-empty-cart-add-form]')) {
      e.preventDefault();

      const form = e.target;
      const button = form.querySelector('.cart-empty-recommendations__add-button');
      const originalButtonText = button.textContent;

      button.disabled = true;
      button.textContent = 'Adding...';

      try {
        const formData = new FormData(form);
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          const item = await response.json();

          // Get updated cart to refresh the drawer
          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();

          if (window.cartDrawer) {
            window.cartDrawer.updateCart(cart);
          }

          // Update cart count in header
          const cartCounts = document.querySelectorAll('[data-cart-count]');
          cartCounts.forEach(el => {
            el.textContent = cart.item_count;
            if (cart.item_count === 0) {
              el.style.display = 'none';
            } else {
              el.style.display = '';
            }
          });

          button.textContent = 'Added!';
          button.style.opacity = '0.7';

          setTimeout(() => {
            button.textContent = originalButtonText;
            button.disabled = false;
            button.style.opacity = '';
          }, 2000);
        } else {
          throw new Error('Failed to add item');
        }
      } catch (error) {
        console.error('Error adding item to cart:', error);
        button.textContent = originalButtonText;
        button.disabled = false;
      }
    }
  });

{% endjavascript %}