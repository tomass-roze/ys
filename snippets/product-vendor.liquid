{% doc %}
  Renders the product vendor/brand name.

  @param {block} block - The block object containing settings
  @param {product} product - The product object

  @example
  {% render 'product-vendor', block: block, product: product %}
{% enddoc %}

{%- if product.vendor and block.settings.show_vendor -%}
  <div
    class="product-block-wrapper"
    style="
      --padding-top: {{ block.settings.padding_top | default: 0 }}px;
      --padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    "
    {{ block.shopify_attributes }}
  >
    <p
      class="product-vendor {{ block.settings.text_style }}"
      style="--text-align: {{ block.settings.alignment }}"
    >
      {{ product.vendor }}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-block-wrapper {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .product-vendor {
    margin: 0;
    text-align: var(--text-align);
  }

  .product-vendor--uppercase {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .product-vendor--normal {
    font-size: 1rem;
    opacity: 0.8;
  }

  .product-vendor--bold {
    font-size: 1rem;
    font-weight: 600;
  }
{% endstylesheet %}