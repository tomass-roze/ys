{% doc %}
  Renders the product price with optional compare-at price.

  @param {block} block - The block object containing settings
  @param {product} product - The product object

  @example
  {% render 'product-price', block: block, product: product %}
{% enddoc %}

<div
  class="product-block-wrapper"
  style="
    --padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div
    class="product-price {{ block.settings.layout }}"
    style="--text-align: {{ block.settings.alignment }}"
  >
    {%- if block.settings.show_compare and product.compare_at_price_max > product.price -%}
      <span class="product-price__compare">
        <s>{{ product.compare_at_price_max | money }}</s>
      </span>
    {%- endif -%}

    <span class="product-price__current">
      {{ product.price | money }}
    </span>

    {%- if block.settings.show_compare and product.compare_at_price_max > product.price -%}
      {%- assign savings = product.compare_at_price_max | minus: product.price -%}
      {%- assign savings_percent = savings | times: 100.0 | divided_by: product.compare_at_price_max | round -%}

      {%- if block.settings.show_savings -%}
        <span class="product-price__savings">
          {{ 'products.blocks.price.save' | t: amount: savings | money }}
          ({{ savings_percent }}%)
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-block-wrapper {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    text-align: var(--text-align);
  }

  .product-price--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .product-price__current {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .product-price__compare {
    font-size: 1.25rem;
    opacity: 0.6;
  }

  .product-price__savings {
    font-size: 0.875rem;
    color: var(--color-success, #16a34a);
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .product-price__current {
      font-size: 1.25rem;
    }

    .product-price__compare {
      font-size: 1rem;
    }
  }
{% endstylesheet %}