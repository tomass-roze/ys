{% doc %}
  Renders a review star rating display with configurable rating, color, and text.

  @param {block} block - The block object containing settings

  @example
  {% render 'product-review-stars', block: block %}
{% enddoc %}

{%- liquid
  assign rating = block.settings.rating | times: 1.0
  assign full_stars = rating | floor
  assign has_half_star = rating | modulo: 1 | times: 2 | floor
  assign empty_stars = 5 | minus: full_stars | minus: has_half_star
-%}

<div
  class="product-review-stars"
  style="
    --star-color: {{ block.settings.star_color }};
    --padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --margin-top: {{ block.settings.margin_top | default: 0 }}px;
    --margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="product-review-stars__rating" role="img" aria-label="{{ 'products.blocks.review_stars.aria_label' | t: rating: rating }}">
    {%- for i in (1..full_stars) -%}
      <svg class="product-review-stars__star product-review-stars__star--full" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    {%- endfor -%}

    {%- if has_half_star == 1 -%}
      <svg class="product-review-stars__star product-review-stars__star--half" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="half-star-{{ block.id }}">
            <stop offset="50%" stop-color="currentColor"/>
            <stop offset="50%" stop-color="#E0E0E0"/>
          </linearGradient>
        </defs>
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#half-star-{{ block.id }})"/>
      </svg>
    {%- endif -%}

    {%- for i in (1..empty_stars) -%}
      <svg class="product-review-stars__star product-review-stars__star--empty" viewBox="0 0 24 24" fill="#E0E0E0" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    {%- endfor -%}
  </div>

  {%- if block.settings.review_text != blank -%}
    <span class="product-review-stars__text">{{ block.settings.review_text }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-review-stars {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--star-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  .product-review-stars__rating {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .product-review-stars__star {
    width: 1rem;
    height: 1rem;
  }

  .product-review-stars__text {
    font-size: 0.875rem;
    color: #6b6b6b;
  }
{% endstylesheet %}
