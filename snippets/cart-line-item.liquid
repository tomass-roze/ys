{% doc %}
  Renders a cart line item with image, details, quantity selector, and remove button.

  @param {line_item} item - The cart line item to render
  @param {boolean} [drawer] - Whether this is being rendered in the cart drawer

  @example
  {% render 'cart-line-item', item: item, drawer: true %}
{% enddoc %}

{%- liquid
  # Check for selling plan status
  assign has_selling_plan = false
  assign can_upgrade = false

  if item.selling_plan_allocation
    assign has_selling_plan = true
    assign selling_plan = item.selling_plan_allocation.selling_plan
    assign subscription_price = item.selling_plan_allocation.price
    assign original_price = item.variant.price
    assign savings_amount = original_price | minus: subscription_price
    assign savings_percent = savings_amount | times: 100.0 | divided_by: original_price | round
  elsif item.variant.selling_plan_allocations.size > 0
    assign can_upgrade = true
    assign first_allocation = item.variant.selling_plan_allocations.first
    assign subscription_price = first_allocation.price
    assign original_price = item.variant.price
    assign savings_amount = original_price | minus: subscription_price
    assign savings_percent = savings_amount | times: 100.0 | divided_by: original_price | round
  endif
-%}

<div class="cart-item" data-cart-item-key="{{ item.key }}">
  {%- comment -%} Main row: Image, Details, Price, Actions {%- endcomment -%}
  <div class="cart-item__main">
    <div class="cart-item__image">
      {% if item.image %}
        {{ item.image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: item.title }}
      {% endif %}
    </div>

    <div class="cart-item__content">
      <div class="cart-item__header">
        <div class="cart-item__info">
          <h3 class="cart-item__title">
            <a href="{{ item.url }}" class="cart-item__link">
              {{ item.product.title }}
            </a>
          </h3>

          {% unless item.product.has_only_default_variant %}
            <div class="cart-item__variant">
              {{ item.variant.title }}
            </div>
          {% endunless %}

          {%- if has_selling_plan -%}
            <div class="cart-item__subscription-price">
              <span class="cart-item__price-current">{{ subscription_price | money }}</span>
              <span class="cart-item__price-frequency">/ {{ 'cart.month' | t }}</span>
              {%- if original_price > subscription_price -%}
                <span class="cart-item__price-original">{{ original_price | money }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- unless has_selling_plan -%}
          <div class="cart-item__price">
            <span class="cart-item__price-final">{{ item.final_line_price | money }}</span>
          </div>
        {%- endunless -%}
      </div>

      {%- comment -%} Actions row: Quantity and Remove {%- endcomment -%}
      <div class="cart-item__actions">
        <div class="cart-item__quantity">
          <button type="button" class="cart-item__quantity-btn" data-quantity-decrease aria-label="Decrease quantity">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2.5 6h7"/>
            </svg>
          </button>
          <input
            type="number"
            name="updates[]"
            id="quantity-{{ item.key }}"
            class="cart-item__quantity-input"
            value="{{ item.quantity }}"
            min="0"
            data-quantity-input
            data-cart-item-key="{{ item.key }}"
            aria-label="{{ 'cart.quantity' | t }}"
          >
          <button type="button" class="cart-item__quantity-btn" data-quantity-increase aria-label="Increase quantity">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6 2.5v7M2.5 6h7"/>
            </svg>
          </button>
        </div>

        <button type="button" class="cart-item__remove" data-cart-remove="{{ item.key }}" aria-label="{{ 'cart.remove' | t }}">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.25">
            <path d="M3 5h12M7 5V3.5a1 1 0 011-1h2a1 1 0 011 1V5m2 0v9.5a1 1 0 01-1 1H6a1 1 0 01-1-1V5h10z"/>
            <path d="M7.5 8v5M10.5 8v5"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Full-width subscription note (below the item) {%- endcomment -%}
  {%- if has_selling_plan -%}
    {%- liquid
      assign subscription_note = settings.subscription_note_text | default: 'Recurring subscription billed and shipped every month at {percentage}% off every following order.'
      assign subscription_note = subscription_note | replace: '{percentage}', savings_percent
    -%}
    <div class="cart-item__subscription-note">
      <svg class="cart-item__subscription-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1.75 7a5.25 5.25 0 1 0 1.54-3.71" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M1.75 1.75v1.5h1.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{ subscription_note }}</span>
    </div>
  {%- endif -%}

  {%- comment -%} Full-width subscription upgrade CTA (below the item) {%- endcomment -%}
  {%- if can_upgrade -%}
    {%- liquid
      assign upgrade_text = settings.subscription_upgrade_text | default: 'Get an additional {percentage}% OFF when you subscribe. Pause or cancel anytime.'
      assign upgrade_text = upgrade_text | replace: '{percentage}', savings_percent
      assign button_text = settings.subscription_button_text | default: 'Subscribe'
    -%}
    <div class="cart-item__upgrade">
      <div class="cart-item__upgrade-text">
        {{ upgrade_text }}
      </div>
      <button
        type="button"
        class="cart-item__upgrade-button"
        data-upgrade-subscription
        data-item-key="{{ item.key }}"
        data-variant-id="{{ item.variant.id }}"
        data-selling-plan-id="{{ first_allocation.selling_plan.id }}"
        data-quantity="{{ item.quantity }}"
      >
        {{ button_text }}
      </button>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-item {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cart-item__main {
    display: flex;
    gap: 0.875rem;
  }

  .cart-item__image {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    background: var(--color-background-secondary, #f5f5f5);
    border-radius: 8px;
    overflow: hidden;
  }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cart-item__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-item__info {
    flex: 1;
    min-width: 0;
  }

  .cart-item__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .cart-item__link {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cart-item__link:hover {
    text-decoration: underline;
  }

  .cart-item__variant {
    font-size: 0.8125rem;
    color: var(--color-foreground-secondary, #666);
    margin-top: 0.125rem;
  }

  .cart-item__properties {
    font-size: 0.75rem;
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .cart-item__property-label {
    font-weight: 500;
  }

  .cart-item__property-value {
    color: var(--color-foreground-secondary, #666);
    margin-right: 0.5rem;
  }

  /* Price column */
  .cart-item__price {
    text-align: right;
    flex-shrink: 0;
  }

  .cart-item__price-compare {
    display: block;
    font-size: 0.75rem;
    color: var(--color-foreground-secondary, #666);
    text-decoration: line-through;
  }

  .cart-item__price-final {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* Subscription price (inline with details) */
  .cart-item__subscription-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-top: 0.375rem;
  }

  .cart-item__price-current {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .cart-item__price-frequency {
    font-size: 0.8125rem;
    color: var(--color-foreground-secondary, #666);
  }

  .cart-item__price-original {
    font-size: 0.8125rem;
    color: var(--color-foreground-secondary, #666);
    text-decoration: line-through;
    margin-left: 0.25rem;
  }

  /* Subscription note (full width below item) */
  .cart-item__subscription-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-background-secondary, #f8f8f8);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--color-foreground-secondary, #666);
    line-height: 1.4;
  }

  .cart-item__subscription-icon {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  /* Upgrade CTA */
  .cart-item__upgrade {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-accent-light, #f5f1e6);
    border-radius: 6px;
  }

  .cart-item__upgrade-text {
    font-size: 0.8125rem;
    color: var(--color-foreground);
    line-height: 1.35;
  }

  .cart-item__upgrade-button {
    flex-shrink: 0;
    padding: 0.5rem 0.875rem;
    background: var(--color-accent, #b8a472);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .cart-item__upgrade-button:hover {
    background: var(--color-accent-dark, #a08a5a);
  }

  /* Actions row */
  .cart-item__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-item__quantity {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 4px;
  }

  .cart-item__quantity-btn {
    background: none;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-foreground);
    transition: background-color 0.2s;
  }

  .cart-item__quantity-btn:hover {
    background: var(--color-background-secondary, #f5f5f5);
  }

  .cart-item__quantity-input {
    width: 40px;
    height: 32px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border, #e5e5e5);
    border-right: 1px solid var(--color-border, #e5e5e5);
    font-size: 0.875rem;
    background: var(--color-background);
    -moz-appearance: textfield;
  }

  .cart-item__quantity-input::-webkit-inner-spin-button,
  .cart-item__quantity-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item__remove {
    background: none;
    border: none;
    padding: 0.375rem;
    cursor: pointer;
    color: var(--color-foreground-secondary, #999);
    transition: color 0.2s;
  }

  .cart-item__remove:hover {
    color: var(--color-error, #d32f2f);
  }

  @media (max-width: 480px) {
    .cart-item__image {
      flex: 0 0 64px;
      width: 64px;
      height: 64px;
    }

    .cart-item__title {
      font-size: 0.875rem;
    }

    .cart-item__upgrade {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .cart-item__upgrade-button {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Quantity button handlers
    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-quantity-decrease]')) {
        const container = e.target.closest('.cart-item__quantity');
        const input = container.querySelector('[data-quantity-input]');
        const currentValue = parseInt(input.value) || 0;
        if (currentValue > 0) {
          input.value = currentValue - 1;
          updateCartQuantity(input);
        }
      }

      if (e.target.closest('[data-quantity-increase]')) {
        const container = e.target.closest('.cart-item__quantity');
        const input = container.querySelector('[data-quantity-input]');
        const currentValue = parseInt(input.value) || 0;
        input.value = currentValue + 1;
        updateCartQuantity(input);
      }

      // Remove item handler
      if (e.target.closest('[data-cart-remove]')) {
        const button = e.target.closest('[data-cart-remove]');
        const key = button.dataset.cartRemove;
        removeCartItem(key);
      }

      // Subscription upgrade handler
      if (e.target.closest('[data-upgrade-subscription]')) {
        const button = e.target.closest('[data-upgrade-subscription]');
        upgradeToSubscription(button);
      }
    });

    // Input change handler
    document.addEventListener('change', (e) => {
      if (e.target.matches('[data-quantity-input]')) {
        updateCartQuantity(e.target);
      }
    });

    let updateTimer;
    function updateCartQuantity(input) {
      clearTimeout(updateTimer);
      updateTimer = setTimeout(() => {
        const key = input.dataset.cartItemKey;
        const quantity = parseInt(input.value) || 0;

        fetch('/cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: key,
            quantity: quantity
          })
        })
        .then(response => response.json())
        .then(cart => {
          if (window.cartDrawer) {
            window.cartDrawer.updateCart(cart);
          }
          updateCartCount(cart.item_count);
        })
        .catch(error => {
          console.error('Error updating cart:', error);
        });
      }, 500);
    }

    function removeCartItem(key) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: key,
          quantity: 0
        })
      })
      .then(response => response.json())
      .then(cart => {
        if (window.cartDrawer) {
          window.cartDrawer.updateCart(cart);
        }
        updateCartCount(cart.item_count);
      })
      .catch(error => {
        console.error('Error removing item:', error);
      });
    }

    function updateCartCount(count) {
      const cartCounts = document.querySelectorAll('[data-cart-count]');
      cartCounts.forEach(el => {
        el.textContent = count;
        el.style.display = count === 0 ? 'none' : '';
      });
    }

    async function upgradeToSubscription(button) {
      const itemKey = button.dataset.itemKey;
      const variantId = button.dataset.variantId;
      const sellingPlanId = button.dataset.sellingPlanId;
      const quantity = parseInt(button.dataset.quantity) || 1;

      // Disable button during process
      button.disabled = true;
      const originalText = button.textContent;
      button.textContent = '...';

      try {
        // Step 1: Remove the current one-time item
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: itemKey,
            quantity: 0
          })
        });

        // Step 2: Add the item with the selling plan
        const addResponse = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity,
            selling_plan: sellingPlanId
          })
        });

        if (!addResponse.ok) {
          throw new Error('Failed to add subscription item');
        }

        // Step 3: Get updated cart and refresh drawer
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();

        if (window.cartDrawer) {
          window.cartDrawer.updateCart(cart);
        }
        updateCartCount(cart.item_count);

      } catch (error) {
        console.error('Error upgrading to subscription:', error);
        // Reset button on error
        button.disabled = false;
        button.textContent = originalText;
      }
    }
  });
{% endjavascript %}
