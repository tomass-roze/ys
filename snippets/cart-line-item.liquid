{% doc %}
  Renders a cart line item with image, details, quantity selector, and remove button.

  @param {line_item} item - The cart line item to render
  @param {boolean} [drawer] - Whether this is being rendered in the cart drawer

  @example
  {% render 'cart-line-item', item: item, drawer: true %}
{% enddoc %}

<div class="cart-item" data-cart-item-key="{{ item.key }}">
  <div class="cart-item__image">
    {% if item.image %}
      {{ item.image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: item.title }}
    {% endif %}
  </div>

  <div class="cart-item__details">
    <h3 class="cart-item__title">
      <a href="{{ item.url }}" class="cart-item__link">
        {{ item.product.title }}
      </a>
    </h3>

    {% unless item.product.has_only_default_variant %}
      <div class="cart-item__variant">
        {% for option in item.variant.options %}
          <span class="cart-item__variant-option">{{ option }}</span>
          {% unless forloop.last %}/{% endunless %}
        {% endfor %}
      </div>
    {% endunless %}

    {% if item.properties.size > 0 %}
      <dl class="cart-item__properties">
        {% for property in item.properties %}
          {% unless property.first contains '_' %}
            <dt class="cart-item__property-label">{{ property.first }}:</dt>
            <dd class="cart-item__property-value">
              {% if property.last contains '/uploads/' %}
                <a href="{{ property.last }}" target="_blank">{{ property.last | split: '/' | last }}</a>
              {% else %}
                {{ property.last }}
              {% endif %}
            </dd>
          {% endunless %}
        {% endfor %}
      </dl>
    {% endif %}

    {% comment %} Check for subscription eligibility {% endcomment %}
    {% if item.selling_plan_allocation == nil and item.variant.selling_plan_allocations.size > 0 %}
      <div class="cart-item__subscription-upgrade" data-subscription-upgrade>
        <button type="button" class="cart-item__subscription-button" data-subscription-toggle>
          {{ 'cart.upgrade_to_subscription' | t: percentage: 10 }}
        </button>
      </div>
    {% endif %}

    <div class="cart-item__quantity-price">
      <div class="cart-item__quantity">
        <label for="quantity-{{ item.key }}" class="visually-hidden">{{ 'cart.quantity' | t }}</label>
        <button type="button" class="cart-item__quantity-button" data-quantity-decrease aria-label="Decrease quantity">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 8h8"/>
          </svg>
        </button>
        <input
          type="number"
          name="updates[]"
          id="quantity-{{ item.key }}"
          class="cart-item__quantity-input"
          value="{{ item.quantity }}"
          min="0"
          data-quantity-input
          data-cart-item-key="{{ item.key }}"
        >
        <button type="button" class="cart-item__quantity-button" data-quantity-increase aria-label="Increase quantity">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 4v8M4 8h8"/>
          </svg>
        </button>
      </div>

      <button type="button" class="cart-item__remove" data-cart-remove="{{ item.key }}" aria-label="{{ 'cart.remove' | t }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 6h14M8 6V4a1 1 0 011-1h2a1 1 0 011 1v2m3 0v11a1 1 0 01-1 1H6a1 1 0 01-1-1V6h10z"/>
          <path d="M8 10v5M12 10v5"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="cart-item__price">
    {% if item.original_price != item.final_price %}
      <span class="cart-item__original-price">{{ item.original_line_price | money }}</span>
    {% endif %}
    <span class="cart-item__final-price">{{ item.final_line_price | money }}</span>
  </div>
</div>

{% stylesheet %}
  .cart-item {
    display: flex;
    gap: 1rem;
    width: 100%;
  }

  .cart-item__image {
    flex: 0 0 80px;
    width: 80px;
    height: 80px;
    background: var(--color-background-secondary, #f5f5f5);
    border-radius: 8px;
    overflow: hidden;
  }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    flex: 1;
    min-width: 0;
  }

  .cart-item__title {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .cart-item__link {
    color: var(--color-foreground);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-item__link:hover {
    text-decoration: underline;
  }

  .cart-item__variant {
    font-size: 0.8125rem;
    color: var(--color-foreground-secondary, #666);
    margin-bottom: 0.5rem;
  }

  .cart-item__variant-option {
    display: inline-block;
    margin-right: 0.25rem;
  }

  .cart-item__properties {
    font-size: 0.8125rem;
    margin: 0.5rem 0;
  }

  .cart-item__property-label {
    display: inline;
    font-weight: 500;
    margin-right: 0.25rem;
  }

  .cart-item__property-value {
    display: inline;
    color: var(--color-foreground-secondary, #666);
    margin-right: 0.5rem;
  }

  .cart-item__subscription-upgrade {
    margin: 0.5rem 0;
  }

  .cart-item__subscription-button {
    padding: 0.375rem 0.75rem;
    background: var(--color-success-light, #e8f5e9);
    color: var(--color-success, #4caf50);
    border: 1px solid var(--color-success, #4caf50);
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .cart-item__subscription-button:hover {
    background: var(--color-success, #4caf50);
    color: white;
  }

  .cart-item__quantity-price {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .cart-item__quantity {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-item__quantity-button {
    background: none;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-foreground);
    transition: background-color 0.2s;
  }

  .cart-item__quantity-button:hover {
    background: var(--color-background-secondary, #f5f5f5);
  }

  .cart-item__quantity-input {
    width: 48px;
    height: 32px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border, #e5e5e5);
    border-right: 1px solid var(--color-border, #e5e5e5);
    font-size: 0.9375rem;
    background: var(--color-background);
  }

  .cart-item__quantity-input::-webkit-inner-spin-button,
  .cart-item__quantity-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item__remove {
    background: none;
    border: none;
    padding: 0.5rem;
    margin: -0.5rem;
    cursor: pointer;
    color: var(--color-foreground-secondary, #666);
    transition: color 0.2s;
  }

  .cart-item__remove:hover {
    color: var(--color-error, #f44336);
  }

  .cart-item__price {
    text-align: right;
    min-width: max-content;
  }

  .cart-item__original-price {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-foreground-secondary, #666);
    text-decoration: line-through;
  }

  .cart-item__final-price {
    display: block;
    font-size: 1rem;
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 480px) {
    .cart-item__image {
      flex: 0 0 60px;
      width: 60px;
      height: 60px;
    }

    .cart-item__title {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Quantity button handlers
    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-quantity-decrease]')) {
        const input = e.target.closest('.cart-item__quantity').querySelector('[data-quantity-input]');
        const currentValue = parseInt(input.value) || 0;
        if (currentValue > 0) {
          input.value = currentValue - 1;
          updateCartQuantity(input);
        }
      }

      if (e.target.closest('[data-quantity-increase]')) {
        const input = e.target.closest('.cart-item__quantity').querySelector('[data-quantity-input]');
        const currentValue = parseInt(input.value) || 0;
        input.value = currentValue + 1;
        updateCartQuantity(input);
      }

      // Remove item handler
      if (e.target.closest('[data-cart-remove]')) {
        const button = e.target.closest('[data-cart-remove]');
        const key = button.dataset.cartRemove;
        removeCartItem(key);
      }

      // Subscription upgrade handler
      if (e.target.closest('[data-subscription-toggle]')) {
        const button = e.target.closest('[data-subscription-toggle]');
        // Implementation for subscription upgrade would go here
        console.log('Subscription upgrade clicked');
      }
    });

    // Input change handler
    document.addEventListener('change', (e) => {
      if (e.target.matches('[data-quantity-input]')) {
        updateCartQuantity(e.target);
      }
    });

    let updateTimer;
    function updateCartQuantity(input) {
      clearTimeout(updateTimer);
      updateTimer = setTimeout(() => {
        const key = input.dataset.cartItemKey;
        const quantity = parseInt(input.value) || 0;

        fetch('/cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: key,
            quantity: quantity
          })
        })
        .then(response => response.json())
        .then(cart => {
          // Update cart drawer if it exists
          if (window.cartDrawer) {
            window.cartDrawer.updateCart(cart);
          }

          // Update cart count in header
          updateCartCount(cart.item_count);
        })
        .catch(error => {
          console.error('Error updating cart:', error);
        });
      }, 500);
    }

    function removeCartItem(key) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: key,
          quantity: 0
        })
      })
      .then(response => response.json())
      .then(cart => {
        // Remove the item from DOM
        const item = document.querySelector(`[data-cart-item-key="${key}"]`);
        if (item) {
          item.closest('.cart-drawer__item, .cart-item').remove();
        }

        // Update cart drawer if it exists
        if (window.cartDrawer) {
          window.cartDrawer.updateCart(cart);
        }

        // Update cart count in header
        updateCartCount(cart.item_count);
      })
      .catch(error => {
        console.error('Error removing item:', error);
      });
    }

    function updateCartCount(count) {
      const cartCounts = document.querySelectorAll('[data-cart-count]');
      cartCounts.forEach(el => {
        el.textContent = count;
        if (count === 0) {
          el.style.display = 'none';
        } else {
          el.style.display = '';
        }
      });
    }
  });
{% endjavascript %}