{% doc %}
  Renders a Lucide icon with customizable properties.

  @param {string} icon - The Lucide icon name (required)
  @param {string} [class] - Additional CSS classes
  @param {number} [size] - Icon size in pixels (default: 24)
  @param {number} [stroke_width] - Stroke width (default: 2)
  @param {string} [stroke] - Stroke color (default: currentColor)
  @param {string} [fill] - Fill color (default: none)

  @example
  {% render 'lucide-icon', icon: 'search' %}
  {% render 'lucide-icon', icon: 'user', size: 20, class: 'icon-account' %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_stroke = stroke | default: 'currentColor'
  assign icon_fill = fill | default: 'none'
  assign icon_stroke_width = stroke_width | default: 2
  assign icon_class = class | default: ''
-%}

{%- case icon -%}
  {%- when 'search' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-search {{ icon_class }}">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>

  {%- when 'user' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-user {{ icon_class }}">
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>

  {%- when 'shopping-bag' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-shopping-bag {{ icon_class }}">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>

  {%- when 'x' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-x {{ icon_class }}">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>

  {%- when 'x-circle' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-x-circle {{ icon_class }}">
      <circle cx="12" cy="12" r="10"/>
      <line x1="15" y1="9" x2="9" y2="15"/>
      <line x1="9" y1="9" x2="15" y2="15"/>
    </svg>

  {%- when 'menu' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-menu {{ icon_class }}">
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-chevron-down {{ icon_class }}">
      <polyline points="6 9 12 15 18 9"/>
    </svg>

  {%- when 'chevron-right' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-chevron-right {{ icon_class }}">
      <polyline points="9 18 15 12 9 6"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}" stroke="{{ icon_stroke }}" stroke-width="{{ icon_stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon lucide lucide-arrow-right {{ icon_class }}">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>

  {%- else -%}
    <!-- Icon "{{ icon }}" not found in Lucide library -->
{%- endcase -%}