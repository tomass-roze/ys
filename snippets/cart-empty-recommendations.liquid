{% doc %}
  Renders product recommendations for empty cart state.
  Shows 3 featured products in a vertical list layout.

  @param {collection} [collection] - Collection to get recommendations from
  @param {number} [limit] - Number of products to show (default: 3)

  @example
  {% render 'cart-empty-recommendations', collection: collections.all, limit: 3 %}
{% enddoc %}

{% liquid
  assign recommendation_limit = limit | default: 3

  comment
    The collection setting returns a handle string, not a collection object
    We need to use collections[handle] to get the actual collection
  endcomment

  if collection and collection != blank
    assign recommendation_collection = collections[collection]
  endif

  if recommendation_collection == blank
    assign recommendation_collection = collections.all
  endif

  assign recommended_products = recommendation_collection.products | limit: recommendation_limit
%}

{% if recommended_products.size > 0 %}
  <div class="cart-empty-recommendations">
    <h3 class="cart-empty-recommendations__title">{{ 'cart.frequently_bought' | t }}</h3>

    <div class="cart-empty-recommendations__list">
      {% for product in recommended_products %}
        <div class="cart-empty-recommendations__item">
          <a href="{{ product.url }}" class="cart-empty-recommendations__image-link">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: product.title, class: 'cart-empty-recommendations__image' }}
            {% else %}
              <div class="cart-empty-recommendations__placeholder">
                {{ product.title | truncate: 2, '' | upcase }}
              </div>
            {% endif %}
          </a>

          <div class="cart-empty-recommendations__info">
            <h4 class="cart-empty-recommendations__product-title">
              <a href="{{ product.url }}">{{ product.title | truncate: 40 }}</a>
            </h4>

            <form action="/cart/add" method="post" class="cart-empty-recommendations__form" data-empty-cart-add-form>
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              <button type="submit" class="cart-empty-recommendations__add-button" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}
                  {{ 'cart.add_to_cart' | t }}
                {% else %}
                  {{ 'products.sold_out' | t | default: 'Sold out' }}
                {% endif %}
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .cart-empty-recommendations {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-empty-recommendations__title {
    margin: 0 0 1.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .cart-empty-recommendations__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-empty-recommendations__item {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    align-items: center;
  }

  .cart-empty-recommendations__image-link {
    flex-shrink: 0;
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary, #f5f5f5);
  }

  .cart-empty-recommendations__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-empty-recommendations__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground-secondary, #999);
    background: var(--color-background-secondary, #f5f5f5);
  }

  .cart-empty-recommendations__info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-empty-recommendations__product-title {
    margin: 0;
    flex: 1;
  }

  .cart-empty-recommendations__product-title a {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .cart-empty-recommendations__product-title a:hover {
    text-decoration: underline;
  }

  .cart-empty-recommendations__form {
    flex-shrink: 0;
  }

  .cart-empty-recommendations__add-button {
    padding: 0.5rem 1rem;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    border: 2px solid var(--color-primary, #000);
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .cart-empty-recommendations__add-button:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .cart-empty-recommendations__add-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 380px) {
    .cart-empty-recommendations__info {
      flex-direction: column;
      align-items: flex-start;
    }

    .cart-empty-recommendations__form {
      width: 100%;
    }

    .cart-empty-recommendations__add-button {
      width: 100%;
    }
  }
{% endstylesheet %}

