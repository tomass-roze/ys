{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div
  class="product-main"
  style="
    --block-spacing: {{ section.settings.block_spacing }}px;
    --gallery-width: {{ section.settings.gallery_width }}%;
    --content-max-width: {{ section.settings.content_max_width }}px;
  "
>
  <div class="product-main__media">
    {% render 'product-media-gallery', product: product %}
  </div>

  <div class="product-main__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'product-title' -%}
          {% render 'product-title', block: block, product: product %}

        {%- when 'product-vendor' -%}
          {% render 'product-vendor', block: block, product: product %}

        {%- when 'product-price' -%}
          {% render 'product-price', block: block, product: product %}

        {%- when 'product-description' -%}
          {% render 'product-description', block: block, product: product %}

        {%- when 'product-form' -%}
          {% render 'product-form', block: block, product: product %}

        {%- when 'selling-plan' -%}
          {% render 'product-selling-plan', block: block, product: product %}

        {%- when 'product-features' -%}
          {% render 'product-features', block: block, product: product %}

        {%- when 'product-benefits' -%}
          {% render 'product-benefits', block: block, product: product %}

        {%- when 'product-usp' -%}
          {% render 'product-usp', block: block, product: product %}

        {%- when 'product-subtitle' -%}
          <p
            class="product-subtitle"
            style="
              --padding-top: {{ block.settings.padding_top }}px;
              --padding-bottom: {{ block.settings.padding_bottom }}px;
              --margin-top: {{ block.settings.margin_top }}px;
              --margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >
            {{- block.settings.text -}}
          </p>

        {%- when 'review-stars' -%}
          {% render 'product-review-stars', block: block %}

        {%- when 'guarantees' -%}
          <div
            class="product-guarantees"
            style="
              --padding-top: {{ block.settings.padding_top }}px;
              --padding-bottom: {{ block.settings.padding_bottom }}px;
              --margin-top: {{ block.settings.margin_top }}px;
              --margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >
            <div class="product-guarantees__list">
              {%- for i in (1..3) -%}
                {%- assign icon_key = 'icon_' | append: i -%}
                {%- assign heading_key = 'heading_' | append: i -%}
                {%- assign text_key = 'text_' | append: i -%}
                {%- assign icon = block.settings[icon_key] -%}
                {%- assign heading = block.settings[heading_key] -%}
                {%- assign text = block.settings[text_key] -%}

                {%- if icon != 'none' and heading != blank -%}
                  <div class="product-guarantees__item">
                    <div class="product-guarantees__icon">
                      {%- case icon -%}
                        {%- when 'checkmark' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                            <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'shield' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L4 6V11C4 16 7 20 12 22C17 20 20 16 20 11V6L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'calendar' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                            <line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/>
                            <line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        {%- when 'heart' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 21C12 21 3 15 3 9C3 6 5 4 7.5 4C9.5 4 11 5 12 6.5C13 5 14.5 4 16.5 4C19 4 21 6 21 9C21 15 12 21 12 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'star' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L15 8.5L22 9.5L17 14.5L18 21.5L12 18L6 21.5L7 14.5L2 9.5L9 8.5L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'truck' -%}
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="1" y="6" width="13" height="11" rx="1" stroke="currentColor" stroke-width="2"/>
                            <path d="M14 8H17L20 11V17H14V8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="6" cy="19" r="2" stroke="currentColor" stroke-width="2"/>
                            <circle cx="17" cy="19" r="2" stroke="currentColor" stroke-width="2"/>
                          </svg>
                      {%- endcase -%}
                    </div>
                    <div class="product-guarantees__content">
                      <div class="product-guarantees__heading">{{ heading }}</div>
                      {%- if text != blank -%}
                        <div class="product-guarantees__text">{{ text }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

        {%- when 'collapsible-content' -%}
          <div
            class="product-collapsible {% if block.settings.enable_collapsible %}product-collapsible--enabled{% endif %}"
            style="
              --heading-font-size: {{ block.settings.heading_font_size }}px;
              --heading-line-height: {{ block.settings.heading_line_height }};
              --heading-text-transform: {{ block.settings.heading_text_transform }};
              --content-font-size: {{ block.settings.content_font_size }}px;
              --content-line-height: {{ block.settings.content_line_height }};
              --content-text-transform: {{ block.settings.content_text_transform }};
              --border-color: {{ block.settings.border_color }};
              --padding-top: {{ block.settings.padding_top }}px;
              --padding-bottom: {{ block.settings.padding_bottom }}px;
              --margin-top: {{ block.settings.margin_top }}px;
              --margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.show_border_top -%}
              <div class="product-collapsible__border product-collapsible__border--top"></div>
            {%- endif -%}

            {%- if block.settings.enable_collapsible -%}
              <details class="product-collapsible__details" {% if block.settings.default_open %}open{% endif %}>
                {%- if block.settings.heading != blank -%}
                  <summary class="product-collapsible__header">
                    <span class="product-collapsible__heading">{{ block.settings.heading }}</span>
                    <svg class="product-collapsible__icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                {%- endif -%}
                <div class="product-collapsible__content">
                  {%- if block.settings.content_type == 'image' and block.settings.image -%}
                    <button type="button" class="product-collapsible__image-trigger" data-lightbox-trigger>
                      {{ block.settings.image | image_url: width: 800 | image_tag: class: 'product-collapsible__image', loading: 'lazy' }}
                    </button>
                  {%- elsif block.settings.content_type == 'reviews' -%}
                    <div class="product-reviews">
                      {%- for i in (1..5) -%}
                        {%- assign title_key = 'review_' | append: i | append: '_title' -%}
                        {%- assign text_key = 'review_' | append: i | append: '_text' -%}
                        {%- assign author_key = 'review_' | append: i | append: '_author' -%}
                        {%- assign stars_key = 'review_' | append: i | append: '_stars' -%}
                        {%- assign verified_key = 'review_' | append: i | append: '_verified' -%}
                        {%- assign review_title = block.settings[title_key] -%}
                        {%- assign review_text = block.settings[text_key] -%}
                        {%- assign review_author = block.settings[author_key] -%}
                        {%- assign review_stars = block.settings[stars_key] -%}
                        {%- assign review_verified = block.settings[verified_key] -%}
                        {%- if review_title != blank or review_text != blank -%}
                          <div class="product-review">
                            <div class="product-review__stars" aria-label="{{ review_stars }} out of 5 stars">
                              {%- for star in (1..5) -%}
                                <svg class="product-review__star{% if star <= review_stars %} product-review__star--filled{% endif %}" width="18" height="18" viewBox="0 0 24 24" fill="{% if star <= review_stars %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5">
                                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                                </svg>
                              {%- endfor -%}
                            </div>
                            {%- if review_title != blank -%}
                              <h4 class="product-review__title">{{ review_title }}</h4>
                            {%- endif -%}
                            {%- if review_text != blank -%}
                              <p class="product-review__text">{{ review_text }}</p>
                            {%- endif -%}
                            {%- if review_author != blank -%}
                              <div class="product-review__author">{{ review_author }}</div>
                            {%- endif -%}
                            {%- if review_verified -%}
                              <div class="product-review__verified">{{ 'products.reviews.verified_buyer' | t }}</div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </details>
            {%- else -%}
              <div class="product-collapsible__static">
                {%- if block.settings.heading != blank -%}
                  <div class="product-collapsible__heading">{{ block.settings.heading }}</div>
                {%- endif -%}
                <div class="product-collapsible__content">
                  {%- if block.settings.content_type == 'image' and block.settings.image -%}
                    <button type="button" class="product-collapsible__image-trigger" data-lightbox-trigger>
                      {{ block.settings.image | image_url: width: 800 | image_tag: class: 'product-collapsible__image', loading: 'lazy' }}
                    </button>
                  {%- elsif block.settings.content_type == 'reviews' -%}
                    <div class="product-reviews">
                      {%- for i in (1..5) -%}
                        {%- assign title_key = 'review_' | append: i | append: '_title' -%}
                        {%- assign text_key = 'review_' | append: i | append: '_text' -%}
                        {%- assign author_key = 'review_' | append: i | append: '_author' -%}
                        {%- assign stars_key = 'review_' | append: i | append: '_stars' -%}
                        {%- assign verified_key = 'review_' | append: i | append: '_verified' -%}
                        {%- assign review_title = block.settings[title_key] -%}
                        {%- assign review_text = block.settings[text_key] -%}
                        {%- assign review_author = block.settings[author_key] -%}
                        {%- assign review_stars = block.settings[stars_key] -%}
                        {%- assign review_verified = block.settings[verified_key] -%}
                        {%- if review_title != blank or review_text != blank -%}
                          <div class="product-review">
                            <div class="product-review__stars" aria-label="{{ review_stars }} out of 5 stars">
                              {%- for star in (1..5) -%}
                                <svg class="product-review__star{% if star <= review_stars %} product-review__star--filled{% endif %}" width="18" height="18" viewBox="0 0 24 24" fill="{% if star <= review_stars %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5">
                                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                                </svg>
                              {%- endfor -%}
                            </div>
                            {%- if review_title != blank -%}
                              <h4 class="product-review__title">{{ review_title }}</h4>
                            {%- endif -%}
                            {%- if review_text != blank -%}
                              <p class="product-review__text">{{ review_text }}</p>
                            {%- endif -%}
                            {%- if review_author != blank -%}
                              <div class="product-review__author">{{ review_author }}</div>
                            {%- endif -%}
                            {%- if review_verified -%}
                              <div class="product-review__verified">{{ 'products.reviews.verified_buyer' | t }}</div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.show_border_bottom -%}
              <div class="product-collapsible__border product-collapsible__border--bottom"></div>
            {%- endif -%}
          </div>

        {%- when 'separator' -%}
          <hr
            class="product-separator"
            style="
              --separator-color: {{ block.settings.color }};
              --separator-padding-top: {{ block.settings.padding_top }}px;
              --separator-padding-bottom: {{ block.settings.padding_bottom }}px;
              --separator-margin-top: {{ block.settings.margin_top }}px;
              --separator-margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >

        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- comment -%} Lightbox for collapsible content images {%- endcomment -%}
<div class="lightbox" data-lightbox hidden>
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__container">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="lightbox__content" data-lightbox-content>
      <img class="lightbox__image" data-lightbox-image src="" alt="">
    </div>
    <button type="button" class="lightbox__zoom" data-lightbox-zoom aria-label="Zoom">
      <svg class="lightbox__zoom-in" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
      <svg class="lightbox__zoom-out" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </button>
  </div>
</div>

{% stylesheet %}
  .product-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    width: 100%;
  }

  /* Desktop layout - two columns */
  @media screen and (min-width: 750px) {
    .product-main {
      grid-template-columns: var(--gallery-width, 50%) 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  @media screen and (min-width: 1200px) {
    .product-main {
      gap: 4rem;
    }
  }

  /* Media column */
  .product-main__media {
    width: 100%;
    position: sticky;
    top: 2rem;
  }

  /* Content column */
  .product-main__content {
    display: flex;
    flex-direction: column;
    gap: var(--block-spacing, 2rem);
    max-width: var(--content-max-width, 100%);
    margin-left: auto;
    width: 100%;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .product-main__media {
      position: relative;
      top: 0;
    }

    .product-main__content {
      max-width: 100%;
      margin-left: 0;
    }
  }

  /* Guarantees */
  .product-guarantees {
    width: 100%;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  .product-guarantees__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-guarantees__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .product-guarantees__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.125rem;
  }

  .product-guarantees__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-guarantees__content {
    flex: 1;
    min-width: 0;
  }

  .product-guarantees__heading {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.25rem;
  }

  .product-guarantees__text {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
  }

  /* Collapsible Content */
  .product-collapsible {
    width: 100%;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  /* Stack collapsible blocks without gaps - use negative margin to counteract the parent gap */
  .product-collapsible + .product-collapsible {
    margin-top: calc(var(--block-spacing, 32px) * -1);
  }

  /* Prevent double borders when blocks are adjacent */
  .product-collapsible:has(.product-collapsible__border--bottom) + .product-collapsible .product-collapsible__border--top {
    display: none;
  }

  .product-collapsible__border {
    width: 100%;
    height: 1px;
    background-color: var(--border-color);
  }

  .product-collapsible__border--top {
    margin-bottom: 0;
  }

  .product-collapsible__border--bottom {
    margin-top: 0;
  }

  .product-collapsible__heading {
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    text-transform: var(--heading-text-transform);
    font-weight: 400;
    margin: 0;
  }

  .product-collapsible__content {
    font-size: var(--content-font-size);
    line-height: var(--content-line-height);
    text-transform: var(--content-text-transform);
    margin: 0;
  }

  /* Static (non-collapsible) version */
  .product-collapsible__static .product-collapsible__heading {
    margin-bottom: 0.75rem;
  }

  /* Collapsible version */
  .product-collapsible__details {
    width: 100%;
  }

  .product-collapsible__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    padding: 1rem 0;
    user-select: none;
  }

  .product-collapsible__header::-webkit-details-marker {
    display: none;
  }

  .product-collapsible__icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    margin-left: 1rem;
  }

  .product-collapsible__details[open] .product-collapsible__icon {
    transform: rotate(180deg);
  }

  .product-collapsible__details .product-collapsible__content {
    padding: 0 0 1rem;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtitle */
  .product-subtitle {
    margin: 0;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  /* Separator */
  .product-separator {
    border: none;
    height: 1px;
    background-color: var(--separator-color);
    margin: 0;
    width: 100%;
    padding-top: var(--separator-padding-top);
    padding-bottom: var(--separator-padding-bottom);
    margin-top: var(--separator-margin-top);
    margin-bottom: var(--separator-margin-bottom);
  }

  /* Image trigger in collapsible content */
  .product-collapsible__image-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    margin: 0.75rem 0;
  }

  .product-collapsible__image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Reviews */
  .product-reviews {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 0.75rem 0;
  }

  .product-review {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-review__stars {
    display: flex;
    gap: 0.125rem;
    margin-bottom: 0.25rem;
  }

  .product-review__star {
    color: #d4a574;
    flex-shrink: 0;
  }

  .product-review__star--filled {
    fill: #d4a574;
  }

  .product-review__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  .product-review__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0.25rem 0;
    color: var(--color-foreground, #333);
  }

  .product-review__author {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .product-review__verified {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-foreground-muted, #666);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    cursor: pointer;
  }

  .lightbox__container {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 3rem;
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox__content {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    cursor: zoom-in;
  }

  .lightbox.is-zoomed .lightbox__content {
    max-width: 100vw;
    max-height: 100vh;
    overflow: auto;
    cursor: grab;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .lightbox.is-zoomed .lightbox__content:active {
    cursor: grabbing;
  }

  .lightbox.is-zoomed .lightbox__image {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  .lightbox__zoom {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lightbox__zoom:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox__zoom-out {
    display: none;
  }

  .lightbox.is-zoomed .lightbox__zoom-in {
    display: none;
  }

  .lightbox.is-zoomed .lightbox__zoom-out {
    display: block;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const lightbox = document.querySelector('[data-lightbox]');
    if (!lightbox) return;

    const lightboxImage = lightbox.querySelector('[data-lightbox-image]');
    const lightboxContent = lightbox.querySelector('[data-lightbox-content]');
    const closeButtons = lightbox.querySelectorAll('[data-lightbox-close]');
    const zoomButton = lightbox.querySelector('[data-lightbox-zoom]');

    function openLightbox(imageSrc, imageAlt) {
      if (!lightboxImage) return;
      // Get high-res version by replacing width parameter
      const highResSrc = imageSrc.replace(/width=\d+/, 'width=2000');
      lightboxImage.src = highResSrc;
      lightboxImage.alt = imageAlt || '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.hidden = true;
      lightbox.classList.remove('is-zoomed');
      if (lightboxImage) {
        lightboxImage.src = '';
        lightboxImage.style.width = '';
        lightboxImage.style.height = '';
      }
      document.body.style.overflow = '';
      if (lightboxContent) {
        lightboxContent.scrollTop = 0;
        lightboxContent.scrollLeft = 0;
      }
    }

    function toggleZoom() {
      const isZooming = !lightbox.classList.contains('is-zoomed');
      lightbox.classList.toggle('is-zoomed');

      if (isZooming && lightboxImage) {
        // Calculate dimensions to fill viewport on constraining dimension
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        const imageNaturalWidth = lightboxImage.naturalWidth;
        const imageNaturalHeight = lightboxImage.naturalHeight;

        // Calculate scale to fill viewport on each dimension
        const scaleToFillWidth = viewportWidth / imageNaturalWidth;
        const scaleToFillHeight = viewportHeight / imageNaturalHeight;

        // Use the larger scale (fills the smaller dimension, overflows the larger)
        const scale = Math.max(scaleToFillWidth, scaleToFillHeight);

        lightboxImage.style.width = (imageNaturalWidth * scale) + 'px';
        lightboxImage.style.height = (imageNaturalHeight * scale) + 'px';
      } else if (lightboxImage) {
        // Reset dimensions when unzooming
        lightboxImage.style.width = '';
        lightboxImage.style.height = '';
      }

      if (lightboxContent) {
        lightboxContent.scrollTop = 0;
        lightboxContent.scrollLeft = 0;
      }
    }

    // Open lightbox when clicking image triggers
    document.querySelectorAll('[data-lightbox-trigger]').forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        const img = trigger.querySelector('img');
        if (img) {
          openLightbox(img.src, img.alt);
        }
      });
    });

    // Close lightbox
    closeButtons.forEach(function(btn) {
      btn.addEventListener('click', closeLightbox);
    });

    // Zoom toggle via button
    if (zoomButton) {
      zoomButton.addEventListener('click', toggleZoom);
    }

    // Zoom toggle via clicking image
    if (lightboxImage) {
      lightboxImage.addEventListener('click', toggleZoom);
    }

    // Close on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !lightbox.hidden) {
        closeLightbox();
      }
    });
  })();
{% endjavascript %}

