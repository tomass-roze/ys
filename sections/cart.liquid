<div class="cart-page">
  <div class="cart-page__header">
    <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>
  </div>

  {% if settings.show_free_shipping_threshold %}
    {% assign free_shipping_threshold = settings.free_shipping_threshold | times: 100 %}
    {% assign cart_total_price = cart.total_price %}
    {% assign remaining_for_free_shipping = free_shipping_threshold | minus: cart_total_price %}

    <div class="cart-page__free-shipping">
      {% if remaining_for_free_shipping > 0 %}
        {% assign remaining_formatted = remaining_for_free_shipping | money %}
        <p class="cart-page__free-shipping-message">
          {{ 'cart.free_shipping_threshold' | t: amount: remaining_formatted }}
        </p>
        {% assign progress_percentage = cart_total_price | times: 100 | divided_by: free_shipping_threshold %}
        <div class="cart-page__progress-bar">
          <div class="cart-page__progress-fill" style="width: {{ progress_percentage }}%"></div>
        </div>
      {% else %}
        <p class="cart-page__free-shipping-success">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 0C4.48 0 0 4.48 0 10s4.48 10 10 10 10-4.48 10-10S15.52 0 10 0zm-2 15l-5-5 1.41-1.41L8 12.17l7.59-7.59L17 6l-9 9z"/>
          </svg>
          {{ 'cart.free_shipping_success' | t }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      <div class="cart-page__items">
        {% for item in cart.items %}
          <div class="cart-page__item">
            {% render 'cart-line-item', item: item, drawer: false %}
          </div>
        {% endfor %}
      </div>

      <div class="cart-page__footer">
        <div class="cart-page__summary">
          <div class="cart-page__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="cart-page__subtotal-price">{{ cart.total_price | money }}</span>
          </div>

          <p class="cart-page__taxes">
            {{ 'cart.taxes_and_shipping_at_checkout' | t | default: 'Taxes and shipping calculated at checkout' }}
          </p>

          <button type="submit" name="checkout" class="cart-page__checkout-button">
            {{ 'cart.checkout' | t }}
          </button>

          <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue-shopping">
            {{ 'cart.continue_shopping' | t }}
          </a>
        </div>

        {% if settings.show_cart_recommendations %}
          <div class="cart-page__recommendations">
            {% render 'cart-recommendations', collection: settings.cart_recommendations_collection, limit: 4 %}
          </div>
        {% endif %}
      </div>
    </form>
  {% else %}
    <div class="cart-page__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue-shopping cart-page__continue-shopping--primary">
        {{ 'cart.continue_shopping' | t }}
      </a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page {
    max-width: var(--max-page-width);
    margin: 0 auto;
    padding: 2rem var(--min-page-margin);
  }

  .cart-page__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .cart-page__title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }

  .cart-page__free-shipping {
    max-width: 600px;
    margin: 0 auto 2rem;
    padding: 1rem;
    background: var(--color-background-secondary, #f5f5f5);
    border-radius: 8px;
  }

  .cart-page__free-shipping-message {
    margin: 0 0 0.5rem;
    text-align: center;
    font-size: 0.9375rem;
  }

  .cart-page__free-shipping-success {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-success, #4caf50);
    font-weight: 500;
  }

  .cart-page__progress-bar {
    width: 100%;
    height: 8px;
    background: white;
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-page__progress-fill {
    height: 100%;
    background: var(--color-primary, #000);
    transition: width 0.3s ease;
  }

  .cart-page__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .cart-page__items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-page__item {
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
  }

  .cart-page__footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .cart-page__summary {
    max-width: 400px;
    margin: 0 auto;
    width: 100%;
  }

  .cart-page__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border, #e5e5e5);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    margin-bottom: 0.5rem;
  }

  .cart-page__subtotal span:first-child {
    font-size: 1.125rem;
  }

  .cart-page__subtotal-price {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .cart-page__taxes {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-foreground-secondary, #666);
    margin: 0.5rem 0 1.5rem;
  }

  .cart-page__checkout-button {
    width: 100%;
    padding: 1rem;
    background: var(--color-primary, #000);
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .cart-page__checkout-button:hover {
    opacity: 0.9;
  }

  .cart-page__continue-shopping {
    display: block;
    text-align: center;
    margin-top: 1rem;
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .cart-page__continue-shopping--primary {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--color-primary, #000);
    color: white;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .cart-page__continue-shopping--primary:hover {
    opacity: 0.9;
  }

  .cart-page__empty {
    text-align: center;
    padding: 4rem 0;
  }

  .cart-page__empty p {
    font-size: 1.25rem;
    color: var(--color-foreground-secondary, #666);
    margin-bottom: 2rem;
  }

  .cart-page__recommendations {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }

  @media (min-width: 768px) {
    .cart-page__form {
      grid-template-columns: 1fr 400px;
    }

    .cart-page__footer {
      position: sticky;
      top: 2rem;
      height: fit-content;
    }

    .cart-page__summary {
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .cart-page {
      padding: 3rem var(--min-page-margin);
    }

    .cart-page__header {
      margin-bottom: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
