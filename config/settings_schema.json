[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "options": [
          {
            "value": "page",
            "label": "t:options.cart_page"
          },
          {
            "value": "drawer",
            "label": "t:options.cart_drawer"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_announcement",
        "label": "t:labels.cart_announcement",
        "default": "Free shipping on orders over $50!",
        "info": "t:info.cart_announcement"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_threshold",
        "label": "t:labels.show_free_shipping_threshold",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "t:labels.free_shipping_threshold",
        "default": "50",
        "info": "t:info.free_shipping_threshold"
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "t:labels.free_shipping_message",
        "default": "You're {amount} away from free shipping!",
        "info": "t:info.free_shipping_message"
      },
      {
        "type": "text",
        "id": "free_shipping_success_message",
        "label": "t:labels.free_shipping_success_message",
        "default": "You qualify for free shipping!",
        "info": "t:info.free_shipping_success_message"
      },
      {
        "type": "checkbox",
        "id": "show_cart_recommendations",
        "label": "t:labels.show_cart_recommendations",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_recommendations_collection",
        "label": "t:labels.cart_recommendations_collection",
        "info": "t:info.cart_recommendations_collection"
      }
    ]
  }
]
