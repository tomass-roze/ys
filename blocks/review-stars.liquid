{% doc %}
  Renders a review star rating display with configurable rating, color, and text.

  @example
  {% content_for 'block', type: 'review-stars', id: 'review-stars' %}
{% enddoc %}

{%- liquid
  assign rating = block.settings.rating | times: 1.0
  assign full_stars = rating | floor
  assign has_half_star = rating | modulo: 1 | times: 2 | floor
  assign empty_stars = 5 | minus: full_stars | minus: has_half_star
-%}

<div
  class="review-stars"
  style="--star-color: {{ block.settings.star_color }}"
  {{ block.shopify_attributes }}
>
  <div class="review-stars__rating" role="img" aria-label="{{ 'products.blocks.review_stars.aria_label' | t: rating: rating }}">
    {%- for i in (1..full_stars) -%}
      <svg class="review-stars__star review-stars__star--full" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    {%- endfor -%}

    {%- if has_half_star == 1 -%}
      <svg class="review-stars__star review-stars__star--half" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="half-star-{{ block.id }}">
            <stop offset="50%" stop-color="currentColor"/>
            <stop offset="50%" stop-color="#E0E0E0"/>
          </linearGradient>
        </defs>
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#half-star-{{ block.id }})"/>
      </svg>
    {%- endif -%}

    {%- for i in (1..empty_stars) -%}
      <svg class="review-stars__star review-stars__star--empty" viewBox="0 0 24 24" fill="#E0E0E0" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    {%- endfor -%}
  </div>

  {%- if block.settings.review_text != blank -%}
    <span class="review-stars__text">{{ block.settings.review_text }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .review-stars {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--star-color);
  }

  .review-stars__rating {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .review-stars__star {
    width: 1rem;
    height: 1rem;
  }

  .review-stars__text {
    font-size: 0.875rem;
    color: #6b6b6b;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.review_stars.name",
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "t:blocks.review_stars.settings.rating.label",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:blocks.review_stars.settings.star_color.label",
      "default": "#B8860B"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "t:blocks.review_stars.settings.review_text.label",
      "default": "4.9/5.0 (2,127 Reviews)"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.review_stars.name"
    }
  ]
}
{% endschema %}
