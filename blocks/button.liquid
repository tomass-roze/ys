{% doc %}
  Renders a button block with configurable label, link, and style.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{% liquid
  if block.settings.url == blank
    assign element = 'button'
  else
    assign element = 'a'
  endif
%}

<{{ element }}
  class="button {{ block.settings.button_style }}"
  style="
    --font-size: {{ block.settings.font_size }}px;
    --text-align: {{ block.settings.alignment }};
  "
  {% if element == 'a' %}
    href="{{ block.settings.url }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label }}
</{{ element }}>

{% stylesheet %}
  .button {
    display: inline-block;
    padding: 12px 24px;
    border: none;
    border-radius: 4px;
    font-size: var(--font-size);
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .button--primary {
    background-color: var(--color-button-primary, #000);
    color: var(--color-button-primary-text, #fff);
  }
  .button--primary:hover {
    opacity: 0.9;
  }
  .button--secondary {
    background-color: var(--color-button-secondary, #fff);
    color: var(--color-button-secondary-text, #000);
    border: 1px solid var(--color-button-secondary-text, #000);
  }
  .button--secondary:hover {
    background-color: var(--color-button-secondary-text, #000);
    color: var(--color-button-secondary, #fff);
  }
  .button--accent {
    background-color: var(--color-button-accent, #0066cc);
    color: var(--color-button-accent-text, #fff);
  }
  .button--accent:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:labels.button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.button_label",
      "default": "Button text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:labels.button_link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "button--primary", "label": "t:options.button_style.primary" },
        { "value": "button--secondary", "label": "t:options.button_style.secondary" },
        { "value": "button--accent", "label": "t:options.button_style.accent" }
      ],
      "default": "button--primary"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:labels.font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    }
  ],
  "presets": [{ "name": "t:labels.button" }]
}
{% endschema %}
